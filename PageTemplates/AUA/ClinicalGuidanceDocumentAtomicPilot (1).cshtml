@using System.Linq
@using AUA
@using AUA.Helpers
@using CMS.ContentEngine

@inject IContentRetriever ContentRetriever

@{
    // Pilot template -- see pilot_atomic_content_model.md. Resolves content
    // through the linked AUA.ClinicalGuidanceContent reusable item
    // (currentPage.GuidanceContent) instead of the page's own fields.
    //
    // RESOLVED UNKNOWN: RetrieveCurrentPage<T>() defaults LinkedItemsMaxLevel
    // to 0, meaning it does NOT resolve linked reusable-content reference
    // fields unless explicitly told to. Confirmed via Kentico's own
    // ContentRetriever API reference docs. Passing LinkedItemsMaxLevel = 1
    // below fixes it.
    var retrieveParams = new RetrieveCurrentPageParameters
    {
        LinkedItemsMaxLevel = 1
    };
    var currentPage = await ContentRetriever.RetrieveCurrentPage<ClinicalGuidanceDocument>(retrieveParams);
    Layout = null;

    const int auaWebsiteChannelId = 2;
    var breadcrumbs = BreadcrumbHelper.GetAncestorTrail(currentPage.SystemFields.WebPageItemID, auaWebsiteChannelId);

    var linkedContent = currentPage.GuidanceContent?.FirstOrDefault();

    string title = linkedContent?.Title ?? currentPage.Title;
    string headline = linkedContent?.Headline ?? currentPage.Headline;
    string metaDescription = linkedContent?.MetaDescription ?? currentPage.MetaDescription;
    string metaKeywords = linkedContent?.MetaKeywords ?? currentPage.MetaKeywords;
    string body = linkedContent?.Body ?? currentPage.Body;
    bool needsReview = linkedContent?.NeedsManualContentReview ?? currentPage.NeedsManualContentReview;
    bool resolvedFromContentHub = linkedContent != null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@title</title>
    @if (!string.IsNullOrEmpty(metaDescription))
    {
        <meta name="description" content="@metaDescription" />
    }
    @if (!string.IsNullOrEmpty(metaKeywords))
    {
        <meta name="keywords" content="@metaKeywords" />
    }
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body { background-color: #f8f9fa; }
        .aua-page-hero { background-color: #003057; color: #ffffff; padding: 3rem 0; margin-bottom: 2.5rem; }
        .aua-page-hero h1 { font-weight: 700; margin-bottom: 0; }
        .aua-article-body { font-size: 1.05rem; line-height: 1.7; color: #212529; }
        .aua-article-body h2, .aua-article-body h3 { margin-top: 2rem; }
        .aua-article-body table { width: 100%; margin: 1.5rem 0; }
        .aua-review-flag { font-size: 0.85rem; }
        .aua-breadcrumb { --bs-breadcrumb-divider-color: rgba(255,255,255,0.5); margin-bottom: 0.75rem; }
        .aua-breadcrumb a { color: rgba(255,255,255,0.8); text-decoration: none; }
        .aua-breadcrumb a:hover { color: #ffffff; text-decoration: underline; }
        .aua-breadcrumb .active { color: #ffffff; }
        .aua-pilot-banner { font-size: 0.85rem; }
    </style>
</head>
<body>
    <partial name="~/Views/Shared/_HeaderNav.cshtml" />

    <header class="aua-page-hero">
        <div class="container">
            @if (breadcrumbs.Count > 0)
            {
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb aua-breadcrumb">
                        <li class="breadcrumb-item"><a href="/home">Home</a></li>
                        @foreach (var crumb in breadcrumbs)
                        {
                            <li class="breadcrumb-item"><a href="@crumb.Url">@crumb.Title</a></li>
                        }
                        <li class="breadcrumb-item active" aria-current="page">@title</li>
                    </ol>
                </nav>
            }
            <h1>@headline</h1>
        </div>
    </header>

    <main class="container pb-5">
        <div class="row">
            <div class="col-lg-9">
                <div class="alert @(resolvedFromContentHub ? "alert-success" : "alert-danger") aua-pilot-banner" role="alert">
                    @if (resolvedFromContentHub)
                    {
                        <text>Atomic content model pilot: this content was resolved from a linked <strong>AUA.ClinicalGuidanceContent</strong> item in Content Hub, not stored directly on this page.</text>
                    }
                    else
                    {
                        <text>Atomic content model pilot: the linked Content Hub item did NOT resolve (currentPage.GuidanceContent was empty) -- falling back to this page's own (mostly blank) fields. See the comment at the top of this file for what to try next.</text>
                    }
                </div>
                @if (needsReview)
                {
                    <div class="alert alert-warning aua-review-flag" role="alert">
                        This page is flagged for manual content review.
                    </div>
                }
                <div class="aua-article-body">
                    @Html.Raw(body)
                </div>
            </div>
            <div class="col-lg-3"></div>
        </div>
    </main>

    <partial name="~/Views/Shared/_SiteFooter.cshtml" />

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
