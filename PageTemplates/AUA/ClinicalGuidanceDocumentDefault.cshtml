@using AUA
@using AUA.Helpers
@using CMS.ContentEngine

@inject IContentRetriever ContentRetriever

@{
    var currentPage = await ContentRetriever.RetrieveCurrentPage<ClinicalGuidanceDocument>();
    Layout = null;

    const int auaWebsiteChannelId = 2;
    var breadcrumbs = BreadcrumbHelper.GetAncestorTrail(currentPage.SystemFields.WebPageItemID, auaWebsiteChannelId);
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@currentPage.Title</title>
    @if (!string.IsNullOrEmpty(currentPage.MetaDescription))
    {
        <meta name="description" content="@currentPage.MetaDescription" />
    }
    @if (!string.IsNullOrEmpty(currentPage.MetaKeywords))
    {
        <meta name="keywords" content="@currentPage.MetaKeywords" />
    }
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .aua-page-hero {
            background-color: #003057; /* placeholder brand navy - adjust to actual AUA brand color later */
            color: #ffffff;
            padding: 3rem 0;
            margin-bottom: 2.5rem;
        }

        .aua-page-hero h1 {
            font-weight: 700;
            margin-bottom: 0;
        }

        .aua-article-body {
            font-size: 1.05rem;
            line-height: 1.7;
            color: #212529;
        }

        .aua-article-body h2, .aua-article-body h3 {
            margin-top: 2rem;
        }

        .aua-article-body table {
            width: 100%;
            margin: 1.5rem 0;
        }

        .aua-review-flag {
            font-size: 0.85rem;
        }

        .aua-breadcrumb {
            --bs-breadcrumb-divider-color: rgba(255,255,255,0.5);
            margin-bottom: 0.75rem;
        }

        .aua-breadcrumb a {
            color: rgba(255,255,255,0.8);
            text-decoration: none;
        }

        .aua-breadcrumb a:hover {
            color: #ffffff;
            text-decoration: underline;
        }

        .aua-breadcrumb .active {
            color: #ffffff;
        }
    </style>
</head>
<body>
    <partial name="~/Views/Shared/_HeaderNav.cshtml" />

    <header class="aua-page-hero">
        <div class="container">
            @if (breadcrumbs.Count > 0)
            {
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb aua-breadcrumb">
                        <li class="breadcrumb-item"><a href="/home">Home</a></li>
                        @foreach (var crumb in breadcrumbs)
                        {
                            <li class="breadcrumb-item"><a href="@crumb.Url">@crumb.Title</a></li>
                        }
                        <li class="breadcrumb-item active" aria-current="page">@currentPage.Title</li>
                    </ol>
                </nav>
            }
            <h1>@currentPage.Headline</h1>
        </div>
    </header>

    <main class="container pb-5">
        <div class="row">
            <div class="col-lg-9">
                @if (currentPage.NeedsManualContentReview)
                {
                    <div class="alert alert-warning aua-review-flag" role="alert">
                        This page is flagged for manual content review.
                    </div>
                }
                <div class="aua-article-body">
                    @Html.Raw(currentPage.Body)
                </div>
            </div>
            <div class="col-lg-3">
                <!-- Reserved for future use: Site Section taxonomy links, related pages, etc. -->
            </div>
        </div>
    </main>

    <footer class="bg-white border-top py-4 mt-5">
        <div class="container text-muted small">
            American Urological Association
        </div>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
