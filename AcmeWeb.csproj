<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework Condition="'$(TargetFramework)' == ''">net10.0</TargetFramework>
    <RootNamespace>DancingGoat</RootNamespace>
    <UserSecretsId>79c858af-5444-4954-8d08-6592a961e82a</UserSecretsId>
    <SeparatedAdmin Condition="'$(SeparatedAdmin)' == ''">false</SeparatedAdmin>
    <NoWarn>$(NoWarn);KXE0004;KXE0006</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <None Remove="App_Data\CMSModules\WebFarm\webfarm.sync" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="app_offline.htm_" Condition="Exists('app_offline.htm_')" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <!-- Exclude administration parts from the compilation in live-site only deployment  -->
  <ItemGroup Condition="'$(SeparatedAdmin)' == 'true'">
    <Compile Remove="AdminComponents\**" />
  </ItemGroup>
  <PropertyGroup Condition="'$(SeparatedAdmin)' == 'true'">
    <DefineConstants>$(DefineConstants);SEPARATED_ADMIN</DefineConstants>
  </PropertyGroup>
	<ItemGroup>
	  <PackageReference Include="Kentico.Xperience.ManagementApi" Version="31.8.4" />
	  <PackageReference Include="Microsoft.ApplicationInsights.AspNetCore" Version="3.1.2" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.Facebook" Version="10.0.12" />
	  <PackageReference Include="Microsoft.AspNetCore.Authentication.Google" Version="10.0.12" />
	  <PackageReference Include="Microsoft.Extensions.Logging.ApplicationInsights" Version="2.23.0" />
	  <PackageReference Include="XperienceCommunity.DomainAliases" Version="2.1.0" />
	</ItemGroup>
	<ItemGroup>
	  <PackageReference Include="kentico.xperience.admin" Version="31.8.4" Condition="'$(SeparatedAdmin)' == 'false'" />
	  <PackageReference Include="kentico.xperience.azurestorage" Version="31.8.4" />
	  <PackageReference Include="kentico.xperience.cloud" Version="31.8.4" />
	  <PackageReference Include="kentico.xperience.imageprocessing" Version="31.8.4" />
	  <PackageReference Include="kentico.xperience.mjml" Version="31.8.4" />
	  <PackageReference Include="kentico.xperience.webapp" Version="31.8.4" />
	</ItemGroup>
</Project>