@{
    Layout = null;
    ViewData["Title"] = "Ask AUA";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Ask - American Urological Association</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            background-color: #f8f9fa;
        }

        .aua-page-hero {
            background-color: #003057;
            color: #ffffff;
            padding: 3rem 0;
            margin-bottom: 2.5rem;
        }

        .aua-page-hero h1 {
            font-weight: 700;
            margin-bottom: 0.25rem;
        }

        .aua-page-hero p {
            margin-bottom: 0;
            opacity: 0.9;
        }

        #aua-ask-input {
            font-size: 1.15rem;
            padding: 0.75rem 1rem;
        }

        #aua-ask-submit {
            padding: 0.75rem 1.5rem;
        }

        .aua-answer-card {
            background: #fff;
            border: 1px solid #dee2e6;
            border-radius: 0.5rem;
            padding: 1.5rem;
            margin-top: 1.5rem;
            line-height: 1.6;
            white-space: pre-wrap;
        }

        .aua-sources {
            margin-top: 1.25rem;
        }

        .aua-sources h2 {
            font-size: 0.95rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
            color: #6c757d;
            margin-bottom: 0.5rem;
        }

        .aua-sources ul {
            padding-left: 1.25rem;
            margin-bottom: 0;
        }

        .aua-disclaimer {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 1rem;
            border-top: 1px solid #eee;
            padding-top: 0.75rem;
        }

        .aua-loading-state, .aua-error-state {
            color: #6c757d;
            padding: 1.5rem 0;
        }

        .aua-error-state {
            color: #b02a37;
        }
    </style>
</head>
<body>
    <partial name="~/Views/Shared/_HeaderNav.cshtml" />

    <header class="aua-page-hero">
        <div class="container">
            <h1>Ask AUA</h1>
            <p>Ask a question in plain language. Answers are generated by AI from AUA's published content, with sources linked below.</p>
        </div>
    </header>

    <main class="container pb-5" style="max-width: 800px;">
        <form id="aua-ask-form" class="d-flex gap-2">
            <input
                type="text"
                id="aua-ask-input"
                class="form-control"
                placeholder="e.g. What are the treatment options for BPH?"
                autofocus
            />
            <button type="submit" id="aua-ask-submit" class="btn btn-primary flex-shrink-0">Ask</button>
        </form>

        <div id="aua-ask-result"></div>
    </main>

    <footer class="bg-white border-top py-4 mt-5">
        <div class="container text-muted small">
            American Urological Association
        </div>
    </footer>

    <script>
        (function () {
            var form = document.getElementById("aua-ask-form");
            var input = document.getElementById("aua-ask-input");
            var resultEl = document.getElementById("aua-ask-result");

            function escapeHtml(str) {
                var div = document.createElement("div");
                div.textContent = str || "";
                return div.innerHTML;
            }

            form.addEventListener("submit", function (e) {
                e.preventDefault();
                var question = input.value.trim();
                if (!question) {
                    return;
                }

                resultEl.innerHTML = '<div class="aua-loading-state">Thinking...</div>';

                fetch("/ask/query", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ question: question })
                })
                    .then(function (res) {
                        return res.json().then(function (data) {
                            if (!res.ok) {
                                throw new Error(data.error || "Something went wrong.");
                            }
                            return data;
                        });
                    })
                    .then(function (data) {
                        var sourcesHtml = "";
                        if (data.sources && data.sources.length > 0) {
                            sourcesHtml =
                                '<div class="aua-sources"><h2>Sources</h2><ul>' +
                                data.sources.map(function (s) {
                                    return '<li><a href="' + escapeHtml(s.url) + '">' + escapeHtml(s.title) + "</a></li>";
                                }).join("") +
                                "</ul></div>";
                        }

                        resultEl.innerHTML =
                            '<div class="aua-answer-card">' +
                                escapeHtml(data.answer) +
                                sourcesHtml +
                                '<div class="aua-disclaimer">Generated from AUA\'s published content. Not a substitute for professional medical judgment -- review the linked sources directly for full context.</div>' +
                            "</div>";
                    })
                    .catch(function (err) {
                        resultEl.innerHTML = '<div class="aua-error-state">' + escapeHtml(err.message) + "</div>";
                    });
            });
        })();
    </script>
</body>
</html>
